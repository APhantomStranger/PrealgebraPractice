<style>
:root{
  --paper:#F4F7F0;
  --grid:#DCE7DA;
  --card:#FFFFFF;
  --ink:#14304C;
  --ink2:#3B566E;
  --pencil:#6A737E;
  --red:#C1121F;
  --redink:#8E1B18;
  --redline:#EBB9BC;
  --hl:#FFEE9C;
  --ok:#1C6B49;
  --okbg:#E8F4EC;
  --nobg:#FBECEC;
  --rule:#E1E7DC;
  --disp:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;
