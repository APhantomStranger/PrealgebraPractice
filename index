const PER=5;
const state={cur:null,probs:{},score:{},filter:''};
const panel=document.getElementById('panel');
const toc=document.getElementById('toc');
const msel=document.getElementById('msel');
const key=i=>TOPICS[i].short;

function safeGen(i){
  try{return TOPICS[i].gen()}
  catch(e){console.error('gen failed:',TOPICS[i].short,e);
    return{q:'This problem didn\u2019t generate. Press <b>New problems</b>.',ans:'\u2014',accepts:[],hint:'',steps:[['\u2014','\u2014']]}}
}
function ensure(i,force){if(force||!state.probs[i])state.probs[i]=Array.from({length:PER},()=>safeGen(i))}

async function loadProgress(){
  try{const r=await window.storage.get('prealgebra:score2');if(r&&r.value)state.score=JSON.parse(r.value)}catch(e){}
  paint();
}
async function saveProgress(){
  try{await window.storage.set('prealgebra:score2',JSON.stringify(state.score))}catch(e){}
}
const solved=i=>state.score[key(i)]||0;
const isDone=i=>solved(i)>=3;

/* ---------------- sidebar + mobile menu ---------------- */
function buildNav(){
  let html=`<h2>Jump to a topic</h2><button data-go="index" class="${state.cur===null?'on':''}"><span class="n">\u2302</span><span>All topics</span></button><div class="sep"></div>`;
  let lastUnit=null;
  TOPICS.forEach((t,i)=>{
    if(t.unit!==lastUnit){html+=`<div class="unitlab">${t.unit}</div>`;lastUnit=t.unit;}
    html+=`<button data-go="${i}" class="${i===state.cur?'on':''}${isDone(i)?' done':''}"><span class="n">${String(i+1).padStart(2,'0')}</span><span>${t.short}</span><span class="dot"></span></button>`;
  });
  toc.innerHTML=html;
  msel.innerHTML=`<option value="index"${state.cur===null?' selected':''}>\u2302 &nbsp;All topics (index)</option>`+
    TOPICS.map((t,i)=>`<option value="${i}"${i===state.cur?' selected':''}>${String(i+1).padStart(2,'0')} \u00b7 ${t.short}${isDone(i)?' \u2713':''}</option>`).join('');
}

/* ---------------- the index ---------------- */
function renderIndex(){
  const f=state.filter.toLowerCase();
  const done=TOPICS.filter((t,i)=>isDone(i)).length;
  let html=`<div class="idxhead">
      <div>
        <div class="tnum">Index &nbsp;\u00b7&nbsp; ${TOPICS.length} topics &nbsp;\u00b7&nbsp; ${done} with 3+ solved</div>
        <h2>Pick anything. Any order.</h2>
        <p class="idxlede">Topics run in the order the course teaches them, so working straight down builds on itself. But nothing is locked \u2014 if you came here for long division, go straight to long division.</p>
      </div>
      <input id="filt" class="filt" type="text" placeholder="Filter topics\u2026" value="${state.filter.replace(/"/g,'&quot;')}" aria-label="Filter topics">
    </div>`;
  let lastUnit=null,shown=0,open=false;
  TOPICS.forEach((t,i)=>{
    const m=META[t.short]||['',''];
    const hay=(t.short+' '+t.title+' '+m[0]+' '+t.unit).toLowerCase();
    if(f&&hay.indexOf(f)<0)return;
    shown++;
    if(t.unit!==lastUnit){
      if(open)html+='</div>';
      html+=`<div class="unitrow"><span class="uname">${t.unit}</span><span class="uline"></span></div><div class="grid">`;
      lastUnit=t.unit;open=true;
    }
    html+=`<button class="card${isDone(i)?' done':''}" data-go="${i}">
      <div class="cnum">${String(i+1).padStart(2,'0')}${isDone(i)?'<span class="tick">\u2713</span>':''}</div>
      <div class="ctitle">${t.title}</div>
      <div class="cblurb">${m[0]}</div>
      ${solved(i)?`<div class="cbar"><span style="width:${Math.min(100,solved(i)/5*100)}%"></span></div>`:''}
    </button>`;
  });
  if(open)html+='</div>';
  if(!shown)html+=`<div class="empty">Nothing matches \u201c${state.filter}\u201d. Try a shorter word \u2014 <b>fraction</b>, <b>negative</b>, <b>percent</b>, <b>equation</b>.</div>`;
  panel.innerHTML=html;
  const fi=document.getElementById('filt');
  if(fi){
    fi.addEventListener('input',e=>{
      state.filter=e.target.value;
      const pos=e.target.selectionStart;
      renderIndex();
      const n=document.getElementById('filt');n.focus();n.setSelectionRange(pos,pos);
    });
  }
}

/* ---------------- problem cards ---------------- */
function probHTML(p,i){
  return `<div class="prob" data-p="${i}">
    <div class="qrow"><div class="qn">${String(i+1).padStart(2,'0')}</div><div class="q">${p.q}</div></div>
    <div class="tools">
      <input class="ans" type="text" autocomplete="off" spellcheck="false" placeholder="your answer" aria-label="Answer for problem ${i+1}">
      ${p.hint?`<span class="hintx">${p.hint}</span>`:''}
      <button class="btn" data-act="check">Check</button>
      <button class="btn ghost" data-act="work">Walk me through it</button>
      <button class="btn tiny" data-act="swap" title="Swap in a different problem">Swap</button>
    </div>
    <div class="verdict"></div>
    <div class="work"><div class="wh">The whole thing, with reasons</div>${stepsHTML(p)}</div>
  </div>`;
}
function stepsHTML(p){
  return '<ol class="steps">'+(p.steps||[]).filter(Boolean).map(s=>
    `<li><div class="mv">${s[0]}</div><div class="why"><span class="wtag">why</span>${s[1]}</div></li>`).join('')
    +`<li class="final"><div class="mv">Answer: <mark>${p.ans}</mark></div></li></ol>`;
}

/* ---------------- topic view ---------------- */
function renderTopic(){
  const i=state.cur,t=TOPICS[i];ensure(i);
  const m=META[t.short]||['',''];
  const prev=i>0?TOPICS[i-1]:null,next=i<TOPICS.length-1?TOPICS[i+1]:null;
  panel.innerHTML=`
    <div class="crumb"><button class="lnk" data-go="index">\u2190 All topics</button><span>${t.unit}</span></div>
    <div class="thead">
      <div>
        <div class="tnum">${String(i+1).padStart(2,'0')} of ${TOPICS.length}</div>
        <h2>${t.title}</h2>
      </div>
      <button class="btn" data-act="refresh">New problems</button>
    </div>
    ${m[1]?`<div class="pic"><h3>Picture it</h3>${m[1]}</div>`:''}
    <div class="idea"><h3>The idea</h3>${t.idea}</div>
    ${t.watch?`<div class="watch"><h3>Where people slip</h3>${t.watch}</div>`:''}
    <div class="probs">${state.probs[i].map(probHTML).join('')}</div>
    <div class="pager">
      ${prev?`<button data-go="${i-1}"><span class="pl">Previous</span><span class="pt">${prev.short}</span></button>`:'<span></span>'}
      ${next?`<button class="r" data-go="${i+1}"><span class="pl">Next</span><span class="pt">${next.short}</span></button>`:'<span></span>'}
    </div>`;
}
function paint(){state.cur===null?renderIndex():renderTopic();buildNav()}
function go(v){
  state.cur=(v==='index')?null:+v;
  if(state.cur!==null)state.filter='';
  paint();
  window.scrollTo({top:0,behavior:'auto'});
}

/* ---------------- interactions ---------------- */
document.addEventListener('click',e=>{
  const nav=e.target.closest('[data-go]');
  if(nav){go(nav.dataset.go);return}
  const btn=e.target.closest('[data-act]');
  if(!btn)return;
  const act=btn.dataset.act;
  if(act==='refresh'){ensure(state.cur,true);paint();return}
  const card=btn.closest('.prob');if(!card)return;
  const idx=+card.dataset.p;
  if(act==='work'){
    const open=card.querySelector('.work').classList.toggle('show');
    btn.textContent=open?'Hide the walkthrough':'Walk me through it';return;
  }
  if(act==='swap'){
    state.probs[state.cur][idx]=safeGen(state.cur);
    card.outerHTML=probHTML(state.probs[state.cur][idx],idx);return;
  }
  if(act==='check')doCheck(card,idx);
});
document.addEventListener('keydown',e=>{
  if(e.key!=='Enter')return;
  const inp=e.target.closest('input.ans');if(!inp)return;
  const card=inp.closest('.prob');doCheck(card,+card.dataset.p);
});
function doCheck(card,idx){
  const p=state.probs[state.cur][idx];
  const v=card.querySelector('input.ans').value.trim();
  const vd=card.querySelector('.verdict');
  vd.classList.add('show');
  if(!v){vd.className='verdict show n';
    vd.innerHTML='Put something in the box first \u2014 even a guess. A wrong guess you then fix is worth more than a blank you skip.';return}
  const ok=p.accepts.indexOf(norm(v))>-1;
  card.classList.remove('right','wrong');
  if(ok){
    card.classList.add('right');
    vd.className='verdict show y';
    vd.innerHTML='Correct. \u2713 &nbsp;Open the walkthrough anyway if you got it by feel rather than by reasoning \u2014 that\u2019s the difference between this one and the next one.';
    state.score[key(state.cur)]=solved(state.cur)+1;saveProgress();buildNav();
  }else{
    card.classList.add('wrong');
    vd.className='verdict show n';
    vd.innerHTML='Not that one. Try again \u2014 and if you\u2019re stuck, press <b>Walk me through it</b> and read the reasons, not just the moves.';
  }
}
msel.addEventListener('change',e=>go(e.target.value));

paint();
if(window.storage)loadProgress();
</script>

