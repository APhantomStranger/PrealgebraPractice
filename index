.qrow{display:flex;gap:12px;align-items:baseline}
.qn{font-family:var(--mono);font-size:12px;color:var(--red);flex:0 0 auto;padding-top:2px}
.q{font-family:var(--mono);font-size:17.5px;line-height:1.65;color:var(--ink);flex:1}
.q b{font-weight:700}
.q .tag{display:inline-block;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;background:#EEF3EC;color:var(--pencil);border-radius:2px;padding:2px 6px;margin-right:7px;vertical-align:2px}
.tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:13px}
