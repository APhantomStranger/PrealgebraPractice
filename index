*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background-color:var(--paper);
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:26px 26px;
  color:var(--ink);
  font-family:var(--body);
  font-size:17px;
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 90px}

/* ---------- masthead ---------- */
.masthead{display:grid;grid-template-columns:1.15fr .85fr;gap:34px;align-items:end;padding:46px 0 30px;border-bottom:2px solid var(--ink)}
.eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pencil)}
h1{font-family:var(--disp);font-weight:800;font-size:clamp(38px,6vw,68px);line-height:.94;letter-spacing:-.025em;margin:12px 0 0}
h1 em{font-style:normal;color:var(--red)}
.lede{font-size:18px;color:var(--ink2);max-width:44ch;margin:16px 0 0}
.lede em{color:var(--redink)}
.demo{background:var(--card);border:1px solid var(--rule);border-radius:3px;padding:16px 18px 14px;box-shadow:0 1px 0 rgba(20,48,76,.06)}
.demo .dtag{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pencil);margin-bottom:10px}
.demo .dm{font-family:var(--mono);font-size:16px;color:var(--ink)}
.demo .dw{margin-top:8px;border-left:2px solid var(--red);padding-left:11px;color:var(--redink);font-size:15px;line-height:1.45}

/* ---------- layout ---------- */
.cols{display:grid;grid-template-columns:236px 1fr;gap:34px;margin-top:30px;align-items:start}
nav.toc{position:sticky;top:14px;max-height:calc(100vh - 28px);overflow:auto;background:var(--card);border:1px solid var(--rule);border-radius:3px;padding:12px 10px}
.toc h2{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pencil);margin:6px 8px 10px;font-weight:500}
.toc button{display:flex;gap:9px;align-items:baseline;width:100%;text-align:left;background:none;border:0;border-radius:3px;padding:6px 8px;cursor:pointer;font-family:var(--body);font-size:15px;color:var(--ink2);line-height:1.3}
.toc button:hover{background:#F1F5EF;color:var(--ink)}
.toc button.on{background:var(--ink);color:#fff}
.toc button.on .n{color:#8FB4D6}
.toc .n{font-family:var(--mono);font-size:11px;color:var(--pencil);flex:0 0 auto}
.toc button .dot{margin-left:auto;width:6px;height:6px;border-radius:50%;background:var(--ok);flex:0 0 auto;opacity:0;align-self:center}
.toc button.done .dot{opacity:1}
.toc .sep{height:1px;background:var(--rule);margin:9px 8px}

/* ---------- topic panel ---------- */
.panel{min-width:0}
.thead{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;justify-content:space-between;margin-bottom:16px}
.thead .tnum{font-family:var(--mono);font-size:12px;letter-spacing:.12em;color:var(--red);text-transform:uppercase}
.thead h2{font-family:var(--disp);font-weight:700;font-size:clamp(26px,3.6vw,38px);line-height:1.02;letter-spacing:-.02em;margin:5px 0 0}
.idea{background:var(--card);border:1px solid var(--rule);border-left:3px solid var(--ink);border-radius:3px;padding:18px 20px;margin-bottom:14px}
.idea h3{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pencil);margin:0 0 8px;font-weight:500}
.idea p{margin:0 0 10px;color:var(--ink2)}
.idea p:last-child{margin-bottom:0}
.idea b{color:var(--ink);font-weight:600}
.watch{background:#FFF8E8;border:1px solid #F0DFAE;border-left:3px solid #D9A21B;border-radius:3px;padding:14px 18px;margin-bottom:22px;color:#6B4E12;font-size:16px}
.watch h3{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#9A7415;margin:0 0 6px;font-weight:500}

/* ---------- problems ---------- */
.probs{display:flex;flex-direction:column;gap:14px}
.prob{background:var(--card);border:1px solid var(--rule);border-radius:3px;padding:16px 18px}
.prob.right{border-color:#BEDCC9}
