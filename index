input.ans:focus{outline:2px solid var(--ink);outline-offset:1px;background:#fff}
.hintx{font-family:var(--mono);font-size:11.5px;color:var(--pencil)}
button.btn{font-family:var(--disp);font-weight:600;font-size:13.5px;letter-spacing:.005em;border-radius:3px;padding:8px 13px;cursor:pointer;border:1px solid var(--ink);background:var(--ink);color:#fff}
